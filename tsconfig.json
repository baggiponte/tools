{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Node runs the .ts build script and tests by stripping their types, which only works for syntax that is pure
    // annotation: no enums, namespaces or constructor parameter properties.
    "erasableSyntaxOnly": true
  },
  "include": ["src", "tests", "*.ts"],
  "exclude": ["dist"]
}
