{
  "name": "tools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node src/build.ts && CLOUDFLARE_CF_AUTH=true cf-wrangler build",
    "check": "pnpm build && cf deploy --prebuilt --dry-run",
    "deploy": "cf deploy --prebuilt",
    "dev": "node src/build.ts && CLOUDFLARE_CF_AUTH=true cf-wrangler dev --port 8791",
    "test": "playwright test",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "cf": "1.0.0-beta.26",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
